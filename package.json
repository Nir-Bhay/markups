{
  "name": "markups",
  "version": "2.1.0",
  "description": "A powerful, feature-rich markdown editor with live preview, Monaco editor, and premium UI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/prerender-landing.mjs",
    "build": "vite build",
    "prebuild:modular": "node scripts/prerender-landing.mjs",
    "build:modular": "vite build --mode modular",
    "typecheck:landing": "tsc --noEmit -p landing/tsconfig.json",
    "verify:health": "node scripts/verify-health.mjs",
    "preview": "vite preview",
    "lint": "eslint src/ && echo 'Lint passed (0 errors)'",
    "test": "vitest run",
    "test:issue40": "vitest run src/__tests__/videoEmbed.test.js src/__tests__/videoControls.test.js src/__tests__/livePreviewEdit.test.js src/__tests__/markdownService.test.js src/__tests__/sanitize.test.js",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:built": "node scripts/run-built-e2e.mjs",
    "test:e2e:modular": "node scripts/run-e2e-modular.mjs",
    "test:e2e:editor-regressions": "node scripts/run-e2e-modular.mjs tests/e2e/editor-regressions.spec.js",
    "test:e2e:install": "playwright install chromium",
    "verify:runtime": "npm run verify:health && npm run test:e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nir-Bhay/markups.git"
  },
  "keywords": [
    "markdown",
    "editor",
    "live-preview",
    "monaco-editor",
    "mermaid",
    "katex",
    "gfm",
    "github-flavored-markdown"
  ],
  "author": "Nir-Bhay",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Nir-Bhay/markups/issues"
  },
  "homepage": "https://markups.dev",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.1"
    },
    "brace-expansion": "^1.1.21",
    "dompurify": "^3.4.17",
    "happy-dom": "^21.0.4",
    "katex": "^0.18.10",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "appwrite": "29.1.0",
    "clsx": "2.1.1",
    "dexie": "^4.4.7",
    "dompurify": "^3.4.17",
    "gemoji": "^8.1.0",
    "github-markdown-css": "^5.8.1",
    "highlight.js": "11.11.2",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.18.10",
    "lucide-react": "1.67.0",
    "marked": "^18.1.2",
    "marked-alert": "^2.1.2",
    "marked-emoji": "^3.0.0",
    "marked-footnote": "^1.4.0",
    "marked-gfm-heading-id": "^4.1.3",
    "marked-highlight": "^2.2.3",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^11.12.2",
    "monaco-editor": "^0.52.2",
    "monaco-vim": "^0.4.4",
    "prismjs": "^1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwind-merge": "3.4.0",
    "typo-js": "^1.4.0"
  }
}
