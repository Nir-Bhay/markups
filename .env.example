# Public Appwrite client values. These are safe to expose in the browser bundle.
# Never put an Appwrite API key, GitHub App private key, or provider secret here.
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_CLOUD_FUNCTION_ID=
VITE_APPWRITE_CONNECTOR_FUNCTION_ID=

# Optional Google Drive Picker config. Restrict the API key by HTTP referrer and API.
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_DRIVE_APP_ID=
